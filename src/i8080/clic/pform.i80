;   pform.i80 - print car and heap expressions
;
;   Requires: prchar, prspace, prhexA, prnyb, prdec_u16, prstr

;----------------------------------------------------------------------
;   ♠DE ♡F* ┃ Print the ref in DE.
;   This makes no attempt to follow references or interpret obdata;
;   it prints them both as hex values `#pHHHH` and `#oHHHH`.
;
pref        push af
            ld   a,e            ; value LSB
            and  a,%11          ; test type bits
            jp   Z,.ptr         ; %00: pointer
            dec  a
            jp   Z,.smallint    ; %01: embedded 14-bit signed integer
            dec  a
            jp   Z,.sym         ; %10: 1- or 2-char symbol
            ; fallthrough       ; %11: obdata header

.obdata     ld   a,'#'
            call prchar
            ld   a,'o'
            call prchar
            jp   .hexout

.ptr        ld   a,d            ; value MSB
            or   a,a            ; is zero?
            jp   Z,.const       ;   yes: it's a const
            ld   a,'#'          ;    no: it's a pointer
            call prchar
            ld   a,'p'
            call prchar
.hexout     ld   a,d
            call prhexA
            ld   a,e
            call prhexA
            pop  af
            ret

            ;   Const LSB in E and AF saved on stack.
.const      push bc
            push hl
            ld   b,e            ; save const value
            ld   a,e
            or   a,a            ; clear carry
            rrca                ; shift 0,4,8,… right to get index 0,1,2,…
            rrca
            ld   c,a            ; index
            ld   hl,.const_names; start of names list
            inc  c
.curname    dec  c              ; this constant is current name in HL?
            jp   NZ,.nextname   ;   no: move to the next name
            call prstr          ;   yes: print the name
            jp   .cexit
            ;
.nextname   inc  hl             ; move up...
            ld   a,(hl)
            or   a,a
            jp   NZ,.nextname   ;  ...to termination byte
            inc  hl
            ld   a,(hl)
            or   a,a            ; end of list of names?
            jp   NZ,.curname    ;    no: see if this name is the one
            ;
            ld   a,'#'          ;   yes: unknown constant '#cXX'
            call prchar
            ld   a,'c'
            call prchar
            ld   a,b            ; saved constant ID
            call prhexA
.cexit      pop  hl
            pop  bc
            pop  af
            ret
            ;
.const_names                    ; Names for consts $00, $04, $08, …
            db   '#n',0
            db   '#t',0
            db   0

            ;   Intrinsic 14-bit signed integer in DE and AF saved on stack.
.smallint   push de
            push hl
            ld   a,d            ; MSB
            or   a,a            ; negative? (also clear carry)
            jp   P,.positive    ;    no: skip negative processing
.negative
            ld   a,'-'          ; print '-' sign
            call prchar
            ld   a,e            ; unshifted LSB
            cpl                 ; 1s complement
            add  a,1<<2         ; add 1 (still shfited) to get 2s complement
            ld   e,a
            ld   a,d            ; unshifted MSB
            cpl                 ; 1s complement
            adc  a,0            ; carry of +1 into MSB, clear carry
            ld   d,a
            ;
.positive   ;   Entered with unshifted MSB in A
            rra                 ; LSR, low bit to carry
            ld   h,a            ; save rest of MSB to shift later
            ld   a,e            ; unshifted LSB
            rra                 ; shift MSB bit 0 (in carry) in
            ;   Carry from bit 0 may be 0 or 1 depending on whether this is
            ;   originally positive or is now a complemented negative.
            or   a,a            ; clear carry
            ld   l,a            ; save partly shifted LSB
            ld   a,h            ; MSB with one bit remaining to shift
            or   a,a            ; clear carry
            rra                 ; save LSbit in carry
            ld   h,a            ; completed shift of MSB
            ld   a,l
            rra                 ; MSB bit 1 → LSB bit 7
            ld   l,a            ; completed shift of LSB
            ;
            call prdec_u16      ; print numeric portiion
            ;
            pop  hl
            pop  de
            pop  af
            ret

            ;   1- or 2-char intrinsic symbol in DE and AF saved on stack.
.sym        ld   a,e            ; load value LSB
            cp   $82            ; sentinel for sym1?
            jp   NZ,.sym2
.sym1       ld   a,d
            call prchar
            pop  af
            ret
            ;
.sym2       ld   a,d            ; load MSB: first char + bit 6 of second char
            and  $7F            ; clear bit from second char
            call prchar         ; print first char
            ld   a,d            ; load MSB
            rla                 ; copy second char bit 6 to carry
            ld   a,e            ; load LSB: shifted 2nd char
            rra                 ; bring in bit 6 to bit 7, carry gets 0
            rra                 ; and then to bit 6 (carry gets 1)
            call prchar         ; print second char
            pop af
            ret

;----------------------------------------------------------------------
;   ♠DE ♣ADE ┃ Print the form in DE.
;   Prints the bare ref if DE is intrinsic, otherwise takes it as
;   a pointer to a list, recursing into sublists. Currently:
;   • Obdata are printed as a header only.
;   • Dotted lists are not handled.

pform       ld   a,e
            and  a,%11          ; tag bits: is it a pointer or const?
            jp   NZ,pref        ;     no: print this item and done (TCO)
            ld   a,d            ;    yes: check if it's a const
            or   a,a            ; MSB is zero?
            jp   Z,pref         ;    yes: print this item and done (TCO)
.list       push hl             ;     no: we have a list
            ld   a,'('
            call prchar
            ld   h,d            ; HL ← pointer to car
            ld   l,e
.next       ld   e,(hl)         ; DE ← car
            inc  hl
            ld   d,(hl)
            inc  hl             ; now pointing at cdr
            call pform
            ld   e,(hl)         ; DE ← cdr
            inc  hl
            ld   d,(hl)
            ld   a,d            ; cdr=$00 (NIL)?
            or   a,e
            jp   Z,.end         ;   yes: terminate list and we're done
            call prspace        ;    no: next item in list
            ex   de,hl          ; HL ← cdr
            jp   .next

.end        ld   a,')'          ;   yes: terminate list and we're done
            call prchar
            pop  hl
            ret
