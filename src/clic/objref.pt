from    src.clic.objref  import *
import  pytest
param   = pytest.mark.parametrize

####################################################################

@param('expected, seq', [
    (b'',       ''),
    (b'',       b''),
    (b'ABC',    'ABC'),
    (b'ABC',    b'ABC'),
    (b'ABC',    [0x41, 0x42, 0x43]),
])
def test_asbytes(expected, seq):
    assert expected == asbytes(seq)

####################################################################

@param('oref, expected', [
    (NIL,           0x0000),
    (T,             0x0004),
    (const(0x00),   0x0000),
    (const(0xFC),   0x00FC),
])
def test_intrinsic_constants_good(oref, expected):
    assert oref == expected

@param('badval', [
    -1, 0x100,                          # out of range
    1, 2, 3, 0xFB, 0xFD, 0xFE, 0xFF,    # invalid tag bits
])
def test_intrinsic_constants_errors(badval):
    with pytest.raises(ValueError) as ex:
        const(badval)

####################################################################

@param('val', [ 0x0100, 0x0104, 0xFFFC ])
def test_ptr_good(val):
    assert val == ptr(val)

@param('badval', [
    -1, 0x0000, 0x00FC, 0x00FF, 0x10000,    # out of range
    0x0101, 0x0102, 0x0103, 0x0105,         # invalid tag bits
    0xFFFB, 0xFFFD, 0xFFFE, 0xFFFF,         # invalid tag bits
])
def test_ptr_errors(badval):
    with pytest.raises(ValueError) as ex:
        ptr(badval)

####################################################################

@param('sym, f, chars', [
    (0x0082, sym1,  '\x00'),        (0x0182, sym1,  b'\x01'),
    (0x2082, sym1,  ' '),           (0x4082, sym1,  '@'),
    (0x6082, sym1,  '`'),           (0x7F82, sym1,  '\x7F'),
    (0x8082, sym1,  b'\x80'),       (0xFF82, sym1,  b'\xFF'),
    (0x2082, sym12, ' '),

    (0x31CA, sym2,  '12'),          (0xF0C6, sym2,  'pq'),
    (0x0002, sym2,  '\x00\x00'),    (0xFFFE, sym2,  '\x7F\x7F'),
    (0x60BA, sym2,  '`.'),          (0x20BA, sym2,  ' .'),
    (0x31CA, sym12, '12'),
])
def test_sym_good(f, chars, sym):
    oref = f(chars)
    print(f'chars={chars!r} sym=${sym:04X} oref=${oref:04X}')
    assert sym == oref

@param('f, chars', [
    #   Invalid lengths.
    (sym1,  ''),                    (sym1,  'AB'),
    (sym2,  ''),                    (sym2,  'A'),
    (sym2,  'ABC'),
    (sym12, ''),                    (sym12, 'ABC'),
    #   We accept ASCII chars only; use a bytestring for $80-$FF.
    (sym1, 'é'),
    #   Invalid due to our encoding
    (sym2,  '\x80\x01'), (sym2,  '\x01\x80'),   # not 7-bit
    (sym2,  'x '), (sym2,  'x`'),               # collides with 1/2 sentinel
])
def test_sym_errors(f, chars):
    print(f'chars={chars!r}')
    with pytest.raises(ValueError) as ex:
        f(chars)
    print(f'{ex.type.__name__!s}: {ex.value}')

def test_sym2_exhaustive():
    ''' All valid sym2s are distinct and none can be mistaken for a sym1. '''
    orefs = [ sym2(bytes([c,d]))
              for c in range(0x80) for d in range(0x80)
              if d not in b' `'
            ]
    assert len(orefs) == len(set(orefs)), \
        'sym2 returned duplicate syms for unique inputs'
    assert not [ o for o in orefs if o & 0xFF == 0x82 ]

####################################################################

@param('n, oref', [
    (    0, 0x0001),
    (    1, 0x0005),
    ( 8191, 0x7FFD),
    (   -1, 0xFFFD),
    (-8192, 0x8001),
])
def test_smallint_good(n, oref):
    oref = smallint(n)
    print(f'n=${n:04X} oref=${oref:04X}')
    assert oref == oref

@param('n', [ -8193, 8192, ])
def test_smallint_errors(n):
    with pytest.raises(ValueError) as ex:
        smallint(n)
    print(f'{ex.type.__name__!s}: {ex.value}')
