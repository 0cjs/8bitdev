from    testmc.i8080  import  Machine
from    src.clic.objref  import *
import  pytest

test_rig = '''
            cpu  8080
            include src/i8080/std.i80
            include testmc/i8080/tmc/biosdef.i80

            org  $400
            include src/i8080/clic/pform.i80
            include src/i8080/pr/space.i80
            include src/i8080/pr/hex.i80
            include src/i8080/pr/dec.i80
            include src/i8080/pr/str.i80
'''

####################################################################

param   = pytest.mark.parametrize

@param('ref, s', [
    (ptr(0x43BC),       b'#p43BC'),
    (ptr(0x0100),       b'#p0100'),
    (ptr(0xFFFC),       b'#pFFFC'),
    (NIL,               b'#n'),
    (TRUE,              b'#t'),
    (const(0x0C),       b'#c0C'),
    (const(0xFC),       b'#cFC'),

    (smallint(0),       b'0'),
    (smallint(1),       b'1'),
    (smallint(23),      b'23'),
    (smallint(456),     b'456'),
    (smallint(7890),    b'7890'),
    (smallint(8191),    b'8191'),
    (smallint(-1),      b'-1'),
    (smallint(-23),     b'-23'),
    (smallint(-456),    b'-456'),
    (smallint(-7890),   b'-7890'),
    (smallint(-8192),   b'-8192'),

    (sym1('\x00'),      b'\x00'),
    (sym1('a'),         b'a'),
    (sym1(b'\xFF'),     b'\xFF'),
    #
    (sym2('\x00\x00'),  b'\x00\x00'),
    (sym2('\x7F\x7F'),  b'\x7F\x7F'),
    (sym2('01'),        b'01'),
    (sym2('ab'),        b'ab'),         # 2nd char bit 6 clear…
    (sym2(' .'),        b' .'),         #   …and set
    (sym2('`.'),        b'`.'),         # valid as ch1 but not ch2
    #
    #   If we didn't declare space/backtick illegal as the 2nd char of a sym2,
    #   these sym values could be interpreted as a sym2 instead of a sym1.
    (0x7F82,            b'\x7F'),
    (0xFF82,            b'\xFF'),

    #   obdata
    (0x0003,            b'#o0003'),
    (0xFFFF,            b'#oFFFF'),
])
def test_pref_other(m, S, R, loadbios, ref, s):
    print(f'ref ${ref:04X}')
    _, out = loadbios()
    r = R(a=12, bc=0x33bc, de=ref, hl=0x5678)
    m.call(S.pref, r)
    assert s == out.written(), 'output incorrect'
    assert r == m.regs, 'registers not preserved'

@param('ref, s', [
    (NIL,       '#n'),    (TRUE,      '#t'),
    (sym12('a'),'a'),     (0x0123,    '#o0123'),
])
def test_pform_direct(m, S, R, loadbios, s, ref):
    print(refstr(ref).rstrip(), '→', s)
    _, out = loadbios()
    r = R(bc=0x33bc, de=ref, hl=0x5678)
    m.call(S.pform, r)
    assert s == out.written().decode('ASCII', errors='backslashreplace'), \
        'output incorrect'
    assert r == m.regs, 'registers not preserved'

a = sym1('a'); b = sym1('b'); c = sym1('c'); d = sym1('d')
@param('s, form', [
    #   XXX doesn't yet handle dotted lists.
    ('(a)',                 [(a,0)]),
    ('(a b)',               [(a,-1), (b,0)]),
    ('(a (b c) d)',         [(a,-1), (-2,-4), (b,-3), (c,0), (d,0)]),
    ('(((a)) d)',           [(-2,-1), (d,0), (-3,0), (a, 0)]),
    ('(#n #t)',             [(0,-1), (TRUE,0)])
])
def test_pform_heap(m, S, R, loadbios, s, form):
    print('expected:', s)
    heap = 0x0700
    m.depword(heap-0x40, [FREE, FREE]*0x10)
    for (car,cdr),addr in zip(form, range(heap-4, 0x600, -4)):
        m.depword(addr, hval(heap, car), hval(heap, cdr))
   #print(hconsdump(m, heap))
    print(hconslist(m, ptr(heap-4), mapper=lambda x: refstr(x).rstrip()))

    _, out = loadbios()
    preserved = R(bc=0x33bc, hl=0x5678)
    m.call(S.pform, preserved.clone(de=ptr(heap-4)))
    #   XXX This should be added to t8dev as written_str().
    actual = out.written().decode('ASCII', errors='backslashreplace')
    print('  actual:', actual)
    assert s == actual, 'output incorrect'
    assert preserved == m.regs, 'registers not preserved'

def hval(heap, n):
    ' Slighlty nicer way of specifying heap values in tests. '
    if n == 0:  return NIL              # 0: empty list/end of list
    elif n < 0: return heap + (n*4-4)   # -n: offset from top of heap
    else:       return n                # +n: whatever ref it is
