;   clic/heap.i80 - heap allocation and management
;
;   Requires: i8080/arith

; ----------------------------------------------------------------------
;   Externally-defined symbols.

    reqdef   fatal_nomem
;       ↑ Routine to jump to when out of memory, with the caller's address
;       left on the stack.
    reqdef   hcons_ptop
    reqdef   hcons_pbot
;       ↑ Addresses of pointers to the top and bottom of the cons heap. The
;       heap will be allocated from the cell below `hcons_ptop` down to and
;       including the cell at hcons_pbot. The pointers must be initialized
;       externally with dword-aligned values.
    reqdef   hcons_pcur
;       ↑ Address below which the search for a free cell starts.


; ----------------------------------------------------------------------

;   Consts.
C_FREE      equ  $00CC      ; unallocated cons cell

;   ♣* ┃ Initialise the cons heap.
;   Warning: init of a zero-length heap will wipe memory.
;
hconsini    ld   hl,(hcons_pbot)
            ld   d,h            ; DE ← (hcons_pbot)
            ld   e,l
            ld   hl,(hcons_ptop)
            ld   (hcons_pcur),hl; we allocate downwards from top of heap
            call subHLDE
            ld   b,h            ; BC ← heap length in bytes
            ld   c,l
            ld   h,d            ; HL ← bottom of heap
            ld   l,e
            ld   de,C_FREE
.clear      ld   (hl),e
            inc  hl
            dec  bc
            ld   (hl),d
            inc  hl
            dec  bc
            ld   a,b
            or   a,c
            jp   NZ,.clear
            ret

;   ♠DE ♡* ┃ Find and return free cons cell in DE.
;
;   Currently this does no tracking of free cells at all; it simply
;   allocates cells from `hcons_ptop` down to `hcons_pbot` (decrementing
;   `hcons_pcur` every time) until it hits the bottom and returns "out of
;   memory" via a jump to `fatal_nomem`, leaving the current stack
;   unchanged (including return addr of caller).
;
;   [XXX In next version] The allocated cell will still be marked "free"
;   when returned, so it can be abandoned by not writing to its car,
;   letting it remain free. (If you are going to use it, you MUST write a
;   value to the car before calling `hcons` again!) If no free cells are
;   available, this will jump to `fatal_nomem`, leaving the current stack
;   unchanged (including return addr of caller).
;
hcons       push af
            push bc
            push hl
            ; BC ← heap bottom - 1 for later check that BC < cell
            ld   hl,(hcons_pbot)
            dec  hl
            ld   b,h            ; BC ← heap bottom - 1
            ld   c,l
            ; Try cell below last one allocated.
            ld   hl,(hcons_pcur)
            dec  hl             ; move down to next cell
            dec  hl
            dec  hl
            dec  hl
            ; XXX should check that it's free
            ld   d,h            ; DE ← found cell
            ld   e,l
            call cpBCDE         ; inside heap?
            jp   NC,.nomem
            ld   (hcons_pcur),hl; save start of search at next alloc
            pop  hl
            pop  bc
            pop  af
            ret
            ;
.nomem      pop  hl             ; clean up stack so that error handler
            pop  bc             ;   can access caller's address
            pop  af
            jp   fatal_nomem
