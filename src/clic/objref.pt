from    src.clic.objref  import *
from    src.clic.objref  import _symcharstr
from    testmc.generic.memory  import MemoryAccess
import  pytest
param   = pytest.mark.parametrize

####################################################################
#   Utility routines also for public consumption.

@param('expected, seq', [
    (b'',       ''),
    (b'',       b''),
    (b'ABC',    'ABC'),
    (b'ABC',    b'ABC'),
    (b'ABC',    [0x41, 0x42, 0x43]),
])
def test_asbytes(expected, seq):
    assert expected == asbytes(seq)

####################################################################
#   Predicates.

@param('ref, predicate, expected', [
    (r,p,e) for p,e,refs in [
        (isconst,   True,  [ 0x0000, 0x0004, 0x00FC, ]),
        (isconst,   False, [ 0x0001, 0x0002, 0x0003, 0x00FF, 0x0100, ]),
        (isptr,     True,  [ 0x0100, 0x0104, 0xFFFC, ]),
        (isptr,     False, [ 0x0000, 0x00FC, 0x00FF,
                             0x0101, 0x0102, 0x0103, ]),
    ] for r in refs
])
def test_predicate(expected, predicate, ref):
    print(f'expected {expected} = {predicate}(${ref:04X})')
    assert expected == predicate(ref)

####################################################################
#   Construction.

@param('val', [ 0x0100, 0x0104, 0xFFFC ])
def test_ptr_good(val):
    assert val == ptr(val)

@param('badval', [
    -1, 0x0000, 0x00FC, 0x00FF, 0x10000,    # out of range
    0x0101, 0x0102, 0x0103, 0x0105,         # invalid tag bits
    0xFFFB, 0xFFFD, 0xFFFE, 0xFFFF,         # invalid tag bits
])
def test_ptr_errors(badval):
    with pytest.raises(ValueError) as ex:
        ptr(badval)

@param('oref, expected', [
    (NIL,           0x0000),
    (TRUE,          0x0004),
    (const(0x00),   0x0000),
    (const(0xFC),   0x00FC),
])
def test_const_good(oref, expected):
    assert oref == expected

@param('badval', [
    -1, 0x100,                          # out of range
    1, 2, 3, 0xFB, 0xFD, 0xFE, 0xFF,    # invalid tag bits
])
def test_const_error(badval):
    with pytest.raises(ValueError) as ex:
        const(badval)

@param('n, oref', [
    (    0, 0x0001),
    (    1, 0x0005),
    ( 8191, 0x7FFD),
    (   -1, 0xFFFD),
    (-8192, 0x8001),
])
def test_smallint_good(n, oref):
    print(f'n={n}=${n:X} oref=${oref:04X}')
    assert oref == smallint(n)

@param('n', [ -8193, 8192, ])
def test_smallint_errors(n):
    with pytest.raises(ValueError) as ex:
        smallint(n)
    print(f'{ex.type.__name__!s}: {ex.value}')

@param('sym, f, chars', [
    (0x0082, sym1,  '\x00'),        (0x0182, sym1,  b'\x01'),
    (0x2082, sym1,  ' '),           (0x4082, sym1,  '@'),
    (0x6082, sym1,  '`'),           (0x7F82, sym1,  '\x7F'),
    (0x8082, sym1,  b'\x80'),       (0xFF82, sym1,  b'\xFF'),
    (0x2082, sym12, ' '),

    (0x31CA, sym2,  '12'),          (0xF0C6, sym2,  'pq'),
    (0x0002, sym2,  '\x00\x00'),    (0xFFFE, sym2,  '\x7F\x7F'),
    (0x60BA, sym2,  '`.'),          (0x20BA, sym2,  ' .'),
    (0x31CA, sym12, '12'),
])
def test_sym_good(f, chars, sym):
    oref = f(chars)
    print(f'chars={chars!r} sym=${sym:04X} oref=${oref:04X}')
    assert sym == oref

@param('f, chars', [
    #   Invalid lengths.
    (sym1,  ''),                    (sym1,  'AB'),
    (sym2,  ''),                    (sym2,  'A'),
    (sym2,  'ABC'),
    (sym12, ''),                    (sym12, 'ABC'),
    #   We accept ASCII chars only; use a bytestring for $80-$FF.
    (sym1, 'é'),
    #   Invalid due to our encoding
    (sym2,  '\x80\x01'), (sym2,  '\x01\x80'),   # not 7-bit
    (sym2,  'x '), (sym2,  'x`'),               # collides with 1/2 sentinel
])
def test_sym_errors(f, chars):
    print(f'chars={chars!r}')
    with pytest.raises(ValueError) as ex:
        f(chars)
    print(f'{ex.type.__name__!s}: {ex.value}')

def test_sym2_exhaustive():
    ''' All valid sym2s are distinct and none can be mistaken for a sym1. '''
    orefs = [ sym2(bytes([c,d]))
              for c in range(0x80) for d in range(0x80)
              if d not in b' `'
            ]
    assert len(orefs) == len(set(orefs)), \
        'sym2 returned duplicate syms for unique inputs'
    assert not [ o for o in orefs if o & 0xFF == 0x82 ]

####################################################################
#   Inspecting/Printing

@param('pos, char, expected', [
    (0, b'\x00',    '00'),
    (1, b'\x12',    '12'),
    (0, b'\x1F',    '1F'),
    (1, b' ',       '20'),
    (0, b'!',       '_!'),
    (1, b'!',       '!_'),
    (0, b'~',       '_~'),
    (1, b'~',       '~_'),
    (0, b'\x7F',    '7F'),
    (0, b'\x80',    '80'),
    (0, b'\xFF',    'FF'),
])
def test_symcharstr(pos, char, expected):
    assert expected == _symcharstr(char[0], pos)

#   XXX This assumes that the constructor functions work properly!
@param('ref, expected', [
    #   Pointers
    (0xFFFC,            'p:FFFC  '),
    (0xA1B0,            'p:A1B0  '),
    (0x0100,            'p:0100  '),
    #   Smallints and syms.
    (smallint(-8192),   'i:-8192 '),
    (smallint(8191),    'i:8191  '),
    (smallint(345),     'i:345   '),
    (smallint(-1),      'i:-1    '),
    (smallint(0),       'i:0     '),
    (sym1('a'),         's:_a    '),
    (sym1(' '),         's:20    '),
    (sym1('_'),         's:__    '),
    (sym1(b'\xFF'),     's:FF    '),
    (sym2('ab'),        's:_ab_  '),
    (sym2('A_'),        's:_A__  '),
    (sym2('_B'),        's:__B_  '),
    (sym2('AB'),        's:_AB_  '),
    (sym2('!~'),        's:_!~_  '),    # printable char boundaries
    (sym2(b'\x0Bc'),    's:0Bc_  '),
    (sym2(b'd\x0F'),    's:_d0F  '),
    (sym2(b'\x7F\x00'), 's:7F00  '),
    (sym2('__'),        's:____  '),
    #   Consts
    (const(0x00),       'c:#n    '),    # nil
    (const(0x04),       'c:#t    '),    # true
    (const(0x08),       'c:08    '),    # (unknown type)
    (const(0xCC),       'c:--    '),    # free cell in heap
    (const(0xFC),       'c:FC    '),    # (unknown type)
    #   Obdata: type and length, both in hex. Known types will later be
    #   displayed as 2-char lower-case mnemonic codes.
    (0x00FF,            'o:FF,00 '),    # format ID $FF (num $3F), odsize=0
    (0x1FFB,            'o:FB,1F '),    # format ID $FB (num $3E), odsize=31
    (0xFF03,            'o:03,FF '),    # format ID $03 (num $00), odsize=255
])
def test_refstr(ref, expected):
    assert 8 == len(expected)
    s = refstr(ref)
    assert (8, expected) == (len(s), s)

####################################################################
#   Heap dumps

class RAM(MemoryAccess):
    ' Little-endian RAM for testing functions that read memory. '
    is_little_endian = True
    def __init__(self, size=0x10000):   self.mem = bytearray(size)
    def get_memory_seq(self):           return self.mem

def _dumplines(capsys, *args):
    ' Return the output of `hconsdump(*args)` as a list of lines. '
    hconsdump(*args)
    return capsys.readouterr().out.splitlines()

@param('ref', [ TRUE, smallint(123), sym1('x'), sym2('xy'), ])
def test_hconslist_atom(ref):
    print('ref=${ref:04X}')
    assert ref == hconslist(None, ref)

def test_hconslist_nil():
    assert [] == hconslist(None, NIL)

def test_hconslist_list():
    s = smallint
    m = RAM(0x400)
    m.depword(0x100, [s(0),         ptr(0x104)])
    m.depword(0x104, [ptr(0x200),   ptr(0x108)])
    m.depword(0x108, [ptr(0x300),   NIL])
    m.depword(0x200, [s(3),         ptr(0x204)])
    m.depword(0x204, [NIL,          ptr(0x208)])
    m.depword(0x208, [s(4),         NIL])
    m.depword(0x300, [s(7),         NIL])
    expected = [s(0), [s(3), [], s(4)], [s(7)]]
    actual   = hconslist(m, 0x100)
    print('expected:', expected); print('  actual:', actual)
    assert expected == actual

def test_hconsdump_ncells(capsys):
    m = RAM(0x100); m.depword(0xF0, [FREE]*8)
    output = _dumplines(capsys, m, 0x100, 2)
    assert 4 == len(output)         # ncells plus two

def test_hconsdump_free(capsys):
    syms  = [sym2('ab')]*2; frees = [FREE]*2
    heap = syms*3 + frees*2 + syms + frees + syms
    m = RAM(0x100); m.depword(0x100 - 2*len(heap), heap)
    output = _dumplines(capsys, m, 0x100)
    assert 5 == len(output)         # stops at free pair
    assert '00FC: 8A E1 8A E1   s:_ab_   s:_ab_' == output[0]
    assert '00F8: CC 00 CC 00   c:--     c:--'   == output[1]
