;   i8080/clic/rform.i80 - parse CLIC forms
;
;   Requires: clic/rtok.i80, clic/qtok.i80, clic/heap.i80

; ----------------------------------------------------------------------

;   ♠DE ♣?? ♡?? ┃ Read a form, building its AST in the heap as it goes, and
;   return a pointer to the AST in DE. Input terminates on the closing ')'.
;   (Any whitespace in the form, including CRs, is ignored.)
;
;   this list. Input terminates with CR at the top level; CR in nested
;   lists will print a newline, indent and continue input.
;   • Success: Cy=0 DE=AST
;   • Failure: Cy=1 DE=invalid (e.g., parse error because extra ')'
;
;   This uses `rtok` to read tokens, and `qtok` to parse them, and only
;   itself does the necessary heap allocations.
;
;   XXX not clear how to deal with the recursion. Do I create a cons
;   and call `rform` again asking it to deposit the root in that cons?
;   It should cons up the entire sequence until a ')', but then how
;   do I deal with not having a '(' at the top level, when just an
;   atom is supplied? And then there's `()`....
;
rform       call rtok           ; last char in A; also first if 1-char token
            cp   ')'            ; unmatched closing paren? (1-char token)
            scf                 ; (error indication)
            ret Z               ;   yes: return parse error
            cp   '('            ; start of subform?
            jp   NZ,qtok        ;    no: parse atom or fail (TCO)
            jp   rcontlist      ;   yes: continue list (TCO)

;   ??? ┃ Continue reading a list after its opening paren. Reads up to and
;   including the close paren, allocating as necessary. Return the AST root
;   in DE; Cy set indicates error. (That error can obviously never
;   be an extra close paren since it stops reading after consuming the
;   proper close paren).
;
;   XXX check for and deal with stack overflow
;
rcontlist   call rtok
            ld   a,(hl)         ; the first char we actually read, not the
                                ;   terminator that may have been pushed back
            cp   ')'            ; close paren immediately follows open paren?
            jp   NZ,.startlist  ;    no: we're parsing a real list
            ld   DE,C_NIL       ;   yes: it's just a #n
            ret
            ;
.startlist  call hcons          ; DE ← new cons cell
            push de             ; save head of list
            jp   .parsetok

.nexttok    ;   We enter with DE pointing to the cdr of a cons cell whose
            ;   car has been filled with the previous parsed token.
            push de
            call rtok           ; read next token
            pop  de
            ld   a,(hl)         ; the first char we actually read, not the
                                ;   terminator that may have been pushed back
            cp   ')'            ; list completed?
            jp   Z,.done        ;   yes: terminate it and return
            ;   We have a new atom or sublist: allocate a cons for
            ;   it and link the previous cons to the new one.
            push de             ; save pointer to current cdr
            call hcons          ; DE ← new cons cell
            pop  hl             ; HL ← cdr of previous cons cell
            ld   (hl),e         ; fill previous cdr with current cons
            inc  hl
            ld   (hl),d
            ;
            ;   On entry HL must point to the current token buffer
            ;   and DE to the new cons cell for that token, be it
            ;   the next entry in a list or the start of a sublist.
.parsetok   cp   '('            ; sublist?
            jp   Z,.sublist     ;   yes: recursive descent
                                ;    no: parse the next token as an atom
.atom       push de             ; save pointer to current cons
            ld   hl,tokbuf      ; may have been destroyed by .nexttok above
            call qtok           ; DE ← objref parsed from token len C at HL
            pop  hl             ; HL ← (restored) pointer to current cons
            ld   (hl),e         ; store subform pointer in the car
            inc  hl
            ld   (hl),d
            inc  hl
            ex   hl,de          ; DE ← cdr of current cons
            jp   .nexttok

.sublist    push de             ; save pointer to current cons
            call rcontlist      ; DE ← parsed subform cons
            pop  hl             ; HL ← restored pointer to current cons
            ld   (hl),e         ; store subform pointer in the car
            inc  hl
            ld   (hl),d
            inc  hl
            ex   hl,de          ; DE ← cdr of current cons
            jp   .nexttok
            ;

.done       ;   We enter with DE pointing to the cdr of a cons cell whose
            ;   car has been filled with the previous parsed token.
            ex  de,hl
            ld  (hl),LB(C_NIL)  ; terminate list
            inc hl
            ld  (hl),MB(C_NIL)
            pop  de             ; restore head of list we generated
            ret                 ; and return it
